# Google Gemini API — Master Orchestrator ve ajanlar için gerekli.
# Ücretsiz, kredi kartı gerektirmeyen katman: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# İsteğe bağlı — varsayılan: gemini-2.5-flash
GEMINI_MODEL=

# Gmail + Google Calendar entegrasyonu (Email/Calendar Agent). Boş
# bırakılırsa MockEmailProvider/MockCalendarProvider ile demo veriyle
# çalışır — bkz. src/lib/integrations/{gmail,google-calendar}.ts
#
# Kurulum (bir kere yapılır):
#   1. https://console.cloud.google.com/apis/credentials adresinde bir
#      proje açın (veya mevcut birini kullanın).
#   2. "APIs & Services > Library"den Gmail API ve Google Calendar
#      API'yi etkinleştirin.
#   3. "OAuth consent screen"i yapılandırın (External, Testing modu
#      yeterli; kendi Google hesabınızı "Test user" olarak ekleyin).
#   4. "Credentials > Create Credentials > OAuth client ID" ile "Web
#      application" tipinde bir istemci oluşturun. "Authorized redirect
#      URIs" alanına aşağıdaki GOOGLE_REDIRECT_URI değerini birebir
#      girin.
#   5. Oluşan Client ID/Secret'i aşağıya yapıştırın.
#   6. `npm run get-google-token` çalıştırın — tarayıcıda izin verin,
#      script GOOGLE_REFRESH_TOKEN'ı otomatik üretip ekrana basacak;
#      onu da aşağıya yapıştırın.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# `npm run get-google-token` çıktısından yapıştırın.
GOOGLE_REFRESH_TOKEN=

# Supabase — Job Search Agent'ın başvuru takip günlüğü (job_applications
# tablosu, bkz. src/lib/integrations/job-tracker.ts) ve ileride Memory
# Agent için kullanılır. Boş bırakılırsa takip kaydı kalıcı olmaz, yalnızca
# o sunucu oturumunda tutulur (InMemoryApplicationTracker).
#   1. https://supabase.com adresinde ücretsiz bir proje açın.
#   2. SQL Editor'de şu tabloyu oluşturun:
#        create table job_applications (
#          id bigint generated always as identity primary key,
#          tarih timestamptz not null,
#          sirket text, unvan text, ilan_url text,
#          kaynak text, uygunluk_puani int, durum text, not text
#        );
#   3. Project Settings > API'den URL ve anon key'i aşağıya girin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# İsteğe bağlı — RLS (Row Level Security) açıksa anon key yeterli olmaz,
# server-side yazma için service role key gerekir (Supabase Dashboard >
# Project Settings > API > service_role). Yalnızca sunucuda kullanılır,
# NEXT_PUBLIC_ öneki YOKTUR — tarayıcıya asla gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=
