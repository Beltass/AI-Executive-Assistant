# Google Gemini API — Master Orchestrator ve ajanlar için gerekli.
# Ücretsiz, kredi kartı gerektirmeyen katman: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# İsteğe bağlı — varsayılan: gemini-2.5-flash
GEMINI_MODEL=

# Gmail entegrasyonu (Email Agent). Boş bırakılırsa Email Agent otomatik
# olarak MockEmailProvider ile demo verisiyle çalışır — bkz.
# src/lib/integrations/gmail.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# İlk OAuth akışı tamamlandıktan sonra elde edilen refresh token.
GOOGLE_REFRESH_TOKEN=

# Supabase (Memory Agent, kalıcı veri). Faz 1'in ilk dikey diliminde
# henüz kullanılmıyor — Memory Agent eklendiğinde gerekecek.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
