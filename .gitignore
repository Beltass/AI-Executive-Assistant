# Environment / secrets
.env
.env.*
!.env.example

# Google OAuth token + client secrets (never commit)
.google_token.json
*credentials*.json
client_secret*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local advisor state. Two files are the exception: the accountability coach's
# streak/task file and the findings ledger (what the team has already reported).
# The Daily Briefing workflow commits both back to the repository after every
# run, which is what makes them survive the ephemeral GitHub Actions runner —
# the streak, and the promise that the 14:00/18:00/22:00 runs do not repeat the
# morning briefing. Everything else in this directory stays local.
# (The directory itself must NOT be ignored wholesale — git cannot re-include a
# file inside an ignored directory.)
.assistant_state/*
!.assistant_state/accountability.json
!.assistant_state/findings.json

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store
