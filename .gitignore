# Environment / secrets
.env
.env.*
!.env.example

# Google OAuth token + client secrets (never commit)
.google_token.json
*credentials*.json
client_secret*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local advisor state. The accountability coach's streak/task file is the ONE
# exception: the Daily Briefing workflow commits it back to the repository after
# every run, which is what makes the coach's memory survive the ephemeral
# GitHub Actions runner. Everything else in this directory stays local.
# (The directory itself must NOT be ignored wholesale — git cannot re-include a
# file inside an ignored directory.)
.assistant_state/*
!.assistant_state/accountability.json

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store
