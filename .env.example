# AI Executive Assistant — environment configuration
# Copy this file to `.env` and fill in real credentials. Never commit `.env`.

# --- Google (Gmail, Calendar, Drive) ---------------------------------------
# Gmail, Calendar and Drive share ONE Google account / OAuth consent.
# You log in once with `python -m ai_assistant.integrations.google_auth`,
# which stores a refresh token to GOOGLE_TOKEN_FILE and then refreshes the
# short-lived access token automatically on every run.
#
# Provide installed-app ("desktop") OAuth client credentials either inline
# via GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET, or point GOOGLE_CREDENTIALS_FILE
# at a client_secret*.json downloaded from the Google Cloud console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CREDENTIALS_FILE=./client_secret.json
#
# Where the authorized-user token (including the refresh token) is stored.
# Defaults to .google_token.json (git-ignored). Uncomment to override.
# GOOGLE_TOKEN_FILE=.google_token.json
#
# CLOUD PATH (GitHub Actions): a runner has no token file, so supply the SAME
# refresh token through the environment instead. After the one-time local login
# above, read the value out of your GOOGLE_TOKEN_FILE ("refresh_token" field)
# and store it as a repository secret together with the client id/secret:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
# Precedence: token file (if present) -> GOOGLE_REFRESH_TOKEN -> skipped.
# GOOGLE_REFRESH_TOKEN=

# --- Slack ------------------------------------------------------------------
# Bot User OAuth Token from your Slack app (starts with "xoxb-").
# Also used by the daily digest notifier together with SLACK_CHANNEL.
SLACK_BOT_TOKEN=
# Incoming Webhook URL — simplest way to deliver the daily digest to a channel.
# If set, it takes priority over SLACK_BOT_TOKEN + SLACK_CHANNEL.
SLACK_WEBHOOK_URL=
# Channel id or name (e.g. "#general") for chat.postMessage delivery.
SLACK_CHANNEL=

# --- Todoist ----------------------------------------------------------------
# Personal API token from Todoist > Settings > Integrations > Developer.
TODOIST_API_TOKEN=

# --- Notion -----------------------------------------------------------------
# Internal integration secret from https://www.notion.so/my-integrations
# (starts with "secret_" or "ntn_").
NOTION_API_KEY=

# --- LLM provider (choose one) ----------------------------------------------
# Google Gemini API key (preferred if both are set).
GEMINI_API_KEY=
# OpenAI API key (used if GEMINI_API_KEY is empty).
OPENAI_API_KEY=
# Gemini generation model (default: gemini-2.5-flash). Must be valid on the
# v1beta generateContent endpoint (e.g. gemini-2.5-flash, gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.5-flash
# Model fallback chain (comma-separated). If the primary model keeps answering
# 503 "model overloaded" (or is unavailable), these are tried in order.
# Leave blank to keep the built-in chain.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.0-flash
# Max output tokens for generation (default: 8192). gemini-2.5-flash is a
# "thinking" model; a low budget truncates the visible answer, so keep it
# generous enough for the deep, multi-section briefings.
# GEMINI_MAX_OUTPUT_TOKENS=8192
# Per-request timeout in seconds (default: 120) so a hung call can never stall
# the daily job. Raise it if you also raise the token budget.
# GEMINI_TIMEOUT_SECONDS=120
# Free-tier resilience — the free Gemini quota returns HTTP 429 after a couple
# of rapid calls, and the service itself occasionally returns 5xx. The client
# retries 429 AND 500/502/503/504 with backoff (honouring Retry-After), then
# falls back to the next model in the chain.
# GEMINI_MAX_RETRIES: how many times to retry a transient failure (default: 4).
# GEMINI_MAX_RETRIES=4
# GEMINI_RETRY_BASE_SECONDS: base backoff in seconds; grows 20s, 40s, 60s, 60s
# by default (capped at 3x the base).
# GEMINI_RETRY_BASE_SECONDS=20
# GEMINI_REQUEST_SPACING_SECONDS: optional pause before each Gemini call to
# spread sequential advisor calls across quota windows (default: 0 = off).
# GEMINI_REQUEST_SPACING_SECONDS=0

# --- Batched digest (free-tier quota saver) ---------------------------------
# The free Gemini tier allows only a couple of generateContent calls per quota
# window, so by default the WHOLE advisor team is served by ONE batched call
# instead of one call per advisor. Set to "false" to go back to per-advisor
# calls (useful for debugging a single section).
# DIGEST_BATCH_MODE=true
# Token budget for that single batched answer — it carries every section, so it
# needs far more headroom than one briefing (default: 32768).
# DIGEST_BATCH_MAX_OUTPUT_TOKENS=32768

# --- Weather advisor (Open-Meteo, FREE, no API key) -------------------------
# City to geocode for the daily weather briefing. Leave empty to use the
# built-in default "Istanbul"; any value here (or a GitHub secret) overrides it.
WEATHER_CITY=
# Optional country name/code to disambiguate the city (e.g. "Turkey" / "TR").
WEATHER_COUNTRY=
# Alternatively, provide explicit coordinates (these override WEATHER_CITY).
# WEATHER_LATITUDE=41.0082
# WEATHER_LONGITUDE=28.9784

# --- Job scout advisor (İş Avcısı) — LLM-backed -----------------------------
# Role keywords to prepare applications and build search links for. Leave empty
# to use the built-in default ("çağrı merkezi müdürü, müşteri deneyimi
# yöneticisi, operasyon müdürü"); a value here overrides it.
# NOTE: the advisor only PREPARES material + plain search URLs; it never logs
# in or auto-submits applications to LinkedIn/Kariyer.net.
JOB_KEYWORDS=
# Location hint used in the search links. Default: "İstanbul".
JOB_LOCATION=

# --- Sector / certs advisors (Sektör İstihbaratı & Sertifika) ---------------
# Your sector/field; tailors sector intel + free-cert suggestions.
# Default if empty: "banka çağrı merkezleri".
USER_SECTOR=
# RSS/Atom feed of sector news folded into the sector briefing. Default if
# empty: a Turkish Google News search feed for "çağrı merkezi banka", so the
# briefing can cite real, verifiable links out of the box.
SECTOR_NEWS_RSS_URL=

# --- AI news advisor (Yapay Zeka Haberleri) ---------------------------------
# RSS/Atom feed of AI news; the latest items are summarized. Default if empty:
# a Turkish Google News search feed for "yapay zeka". If the feed is
# unreachable, the advisor degrades to an LLM roundup (with a caveat).
AI_NEWS_RSS_URL=

# --- Banka & Çağrı Merkezi Proje Uzmanı (deep domain expert) ----------------
# Outsourcing governance + information security + compliance for bank contact
# centers, with a rotating daily deep-dive focus.
# RSS/Atom feed of Turkish banking / contact-center / outsourcing news, folded
# into the briefing so it can cite REAL, verifiable links. Default if empty: a
# Turkish Google News search feed. An unreachable feed degrades to LLM-only.
# NOTE: this advisor deliberately describes regulatory PRINCIPLES and names real
# frameworks (BDDK support-service & information-systems regulations, KVKK,
# ISO/IEC 27001, PCI-DSS, SOC 2) instead of citing article numbers or dates, and
# always appends a "confirm with your compliance/legal team" caveat.
BANKING_NEWS_RSS_URL=
# Second, optional feed for the same advisor, weighted towards regulation, data
# protection and information-security news. Default if empty: a Turkish Google
# News search feed for KVKK / bilgi güvenliği / veri ihlali in banking. Items
# from both feeds are merged and de-duplicated.
BANKING_SECURITY_RSS_URL=

# --- Hesap Sorucu Koç (accountability coach) --------------------------------
# Small JSON file holding each day's assigned tasks + the streak counter.
# Default if empty: .assistant_state/accountability.json.
# On GitHub Actions the runner filesystem is EPHEMERAL, so the Daily Briefing
# workflow COMMITS this file back to `main` after every run — that is what makes
# the streak durable. Leave this unset in CI so the committed default path is
# used; overriding it there silently disables the persistence. A missing file is
# still a clean fresh start. This advisor makes NO LLM call.
ACCOUNTABILITY_STATE_FILE=

# --- Gün Başı Operasyon Brifingi (Gmail + Calendar) -------------------------
# Uses the SHARED Google OAuth above (read-only scopes) — no extra credentials.
# Until you run `python -m ai_assistant.integrations.google_auth` once, this
# advisor reports `skipped`, which is the expected state. To run it in GitHub
# Actions, set the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN
# secrets described in the Google section above.
# How many recent messages to look at (default: 12, hard-capped at 25).
# OPS_BRIEFING_MAX_EMAILS=12
# Gmail "newer_than" window; <n>h or <n>d only (default: 1d).
# OPS_BRIEFING_EMAIL_WINDOW=1d

# --- Anka bridge (Anka Köprüsü) — generic HTTP connector --------------------
# Endpoint for your external "Anka" assistant. This one has NO default — the
# URL is specific to you, so without it the bridge stays `skipped` by design.
# ANKA_API_URL is accepted as an alias for ANKA_WEBHOOK_URL.
ANKA_WEBHOOK_URL=
# ANKA_API_URL=
# Optional bearer token sent as "Authorization: Bearer <key>".
ANKA_API_KEY=
# Optional HTTP method for the trigger request (default: POST).
# ANKA_HTTP_METHOD=POST

# --- Optional tuning --------------------------------------------------------
# Timeout in seconds for each outbound health-check request (default: 10).
AI_ASSISTANT_HTTP_TIMEOUT=10
