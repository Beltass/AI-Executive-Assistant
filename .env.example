# AI Executive Assistant — environment configuration
# Copy this file to `.env` and fill in real credentials. Never commit `.env`.

# --- Google (Gmail, Calendar, Drive) ---------------------------------------
# Gmail, Calendar and Drive share ONE Google account / OAuth consent.
# You log in once with `python -m ai_assistant.integrations.google_auth`,
# which stores a refresh token to GOOGLE_TOKEN_FILE and then refreshes the
# short-lived access token automatically on every run.
#
# Provide installed-app ("desktop") OAuth client credentials either inline
# via GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET, or point GOOGLE_CREDENTIALS_FILE
# at a client_secret*.json downloaded from the Google Cloud console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CREDENTIALS_FILE=./client_secret.json
#
# Where the authorized-user token (including the refresh token) is stored.
# Defaults to .google_token.json (git-ignored). Uncomment to override.
# GOOGLE_TOKEN_FILE=.google_token.json

# --- Slack ------------------------------------------------------------------
# Bot User OAuth Token from your Slack app (starts with "xoxb-").
SLACK_BOT_TOKEN=

# --- Todoist ----------------------------------------------------------------
# Personal API token from Todoist > Settings > Integrations > Developer.
TODOIST_API_TOKEN=

# --- Notion -----------------------------------------------------------------
# Internal integration secret from https://www.notion.so/my-integrations
# (starts with "secret_" or "ntn_").
NOTION_API_KEY=

# --- LLM provider (choose one) ----------------------------------------------
# Google Gemini API key (preferred if both are set).
GEMINI_API_KEY=
# OpenAI API key (used if GEMINI_API_KEY is empty).
OPENAI_API_KEY=

# --- Optional tuning --------------------------------------------------------
# Timeout in seconds for each outbound health-check request (default: 10).
AI_ASSISTANT_HTTP_TIMEOUT=10
